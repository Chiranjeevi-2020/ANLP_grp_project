{
  "run_name": "proto1_colab",
  "seed": 13,
  "model_name": "Qwen/Qwen2.5-1.5B-Instruct",
  "device": "auto",
  "dtype": "float16",
  "wandb": {
    "enabled": true,
    "project": "anlp-context-switching"
  },
  "data": {
    "fills_per_template": {
      "train": 2,
      "dev": 2,
      "test": 2
    }
  },
  "gen": {
    "max_new_tokens": 60,
    "temperature": 0.8,
    "top_p": 0.95,
    "batch_size": 32
  },
  "classify": {
    "max_new_tokens": 4,
    "batch_size": 32
  },
  "features": {
    "layers": [
      16,
      28
    ],
    "batch_size": 32
  },
  "decoder": {
    "rollouts_per_example": 1,
    "methods": [
      "no_switch",
      "scripted",
      "prompt_only"
    ],
    "weight_decays": [
      0.001,
      0.01
    ],
    "epochs": 100,
    "lr": 0.01,
    "min_dev_acc": 0.25,
    "min_gain_over_history": 0.03
  },
  "bank": {
    "k_train": 1,
    "k_dev": 1
  },
  "controller": {
    "topic_emb_dim": 64,
    "hidden_dim": 256,
    "init_std": 0.01
  },
  "rl": {
    "lambda": 1.0,
    "steps": 250,
    "batch_size": 32,
    "lr": 0.002,
    "entropy_coef": 0.01,
    "baseline_momentum": 0.9,
    "grad_clip": 1.0,
    "eval_every": 25
  },
  "smoke": {
    "steps": 3,
    "batch_size": 8
  },
  "eval": {
    "rollouts_per_example": 1,
    "bootstrap": 500
  },
  "_doc": "Fast Colab configuration for 10-15 minute execution on T4 GPU."
}
